import numpy as np
import pandas as pd
import time

# ----------------- Parameters -----------------
T = 1.0
n = 10                # number of time points
K_strike = -0.1          # strike K (change as needed)

M = 32000           # Monte Carlo sample size
d = 10          # number of KL coordinates

np.random.seed(12345)   # reproducibility
# ------------------------------------------------

# time grid: ensure t1 != 0 (use t1 = 1/n)
t = np.linspace(1.0/n, T, n)
dt = t[1] - t[0]

# 1) Simulate Brownian motion marginals (no KL):
start_time = time.time()
increments = np.random.normal(loc=0.0, scale=np.sqrt(dt), size=(M, n))
X = np.cumsum(increments, axis=1)  # shape (M, n)
print(f"Simulated {M} BM paths at {n} times in {time.time()-start_time:.2f}s")

# Payoff phi and Rademacher derivative:
# phi(y) = max(0, mean(y) - K)
means = X.mean(axis=1)               # mean per path (M,)
phi_vals = np.maximum(0.0, means - K_strike)
# Rademacher derivative a.e. for phi(y) = max(0, mean(y)-K):
# phi'(y) = (1/n) * 1_{mean(y) > K} * (1,...,1)
phi_prime_scalars = (means > K_strike).astype(float) / n  # (M,)

# === Estimate Var(phi(X)) from direct-path simulations ===
phi_mean = phi_vals.mean()               # sample mean of phi
phi_var = phi_vals.var(ddof=1)           # unbiased sample variance of phi

# Karhunen-Loève for Brownian motion on [0,1]:
# e_n(t) = sqrt(2/T) * sin(pi*(n-1/2) * t / T)
# lambda_n = (T / (pi*(n-1/2)))^2
def KL_eigen(n_idx, t_grid, T=1.0):
    k = n_idx - 1 + 0.5
    eigfunc = np.sqrt(2.0 / T) * np.sin(np.pi * k * t_grid / T)
    eigval = (T / (np.pi * k))**2
    return eigval, eigfunc


lambdas = np.zeros(d)
Phi = np.zeros((d, n))
for i in range(1, d+1):
    lam, ef = KL_eigen(i, t)
    lambdas[i-1] = lam
    Phi[i-1, :] = ef

# 2) Using simulated (X) compute estimates of:
#    E[sqrt(lambda_i) < phi'(X), Phi_i >]
estimates_phiprime = []
for i in range(d):
    # inner product reduces to phi_prime_scalars * sum_j Phi_i(t_j)
    inner_vals = phi_prime_scalars * np.sum(Phi[i, :])    # (M,) but constant across samples
    samples = np.sqrt(lambdas[i]) * inner_vals
    sample_mean = samples.mean()
    sample_var = samples.var(ddof=1)
    estimates_phiprime.append((i+1, float(sample_mean), float(sample_var)))
    print(f"i={i+1}: mean phiprime = {sample_mean:.6e}, phi prime var = {sample_var:.6e}")
# Precompute cov(V) for Brownian motion: cov(V_p, V_q) = min(t_p, t_q)
covV = np.minimum.outer(t, t)  # (n,n)

# 3+4) For each i: simulate joint (xi_i, phi) using conditional sampling:
#    Y = sqrt(lambda_i) * xi_i; V|Y=y ~ N(AfV|Y(y), K)
#    For Brownian motion AfV|Y is simply e_i (vector), K = covV - lambda_i * e_i e_i^T
# ----------------- New block: joint-d KL conditioning for d=10 -----------------
# Assumes these exist from earlier in your script:
#   M, n, t, dt, Phi (shape (d, n)), lambdas (shape (d,)), covV (n x n),
#   phi_vals (shape (M,)), and you've already computed estimates_phiprime list
# and/or e1 below.

assert d <= Phi.shape[0], "Phi must have at least d rows (eigenfunctions)."

# --- 1) Build e1: vector of est_phiprime_means for i=1..d ---------------------
# If you already computed `estimates_phiprime` as in the earlier script,
# collect the means into e1; otherwise recompute quickly here.
e1 = np.zeros(d)
for i in range(d):
    # earlier we computed estimates_phiprime list as (i, mean, var)
    # if not available, compute mean via phi_prime_scalars and Phi as before
    try:
        e1[i] = estimates_phiprime[i][1]
    except NameError:
        # fallback: compute from phi_prime_scalars (1/n * 1_{mean>K})
        inner_vals = phi_prime_scalars * np.sum(Phi[i, :])          # shape (M,) but constant
        samples = np.sqrt(lambdas[i]) * inner_vals
        e1[i] = samples.mean()

# --- 2) phi mean and var ----------------------------------------------------
phi_mean_direct = float(np.mean(phi_vals))
phi_var_direct  = float(np.var(phi_vals, ddof=1))
print(f"Direct-sim phi: mean = {phi_mean_direct:.6e}, var = {phi_var_direct:.6e}")

# --- 3) Simulate M many samples of (xi_1,...,xi_d) ---------------------------
# xi_mat shape: (M, d), rows are samples
xi_mat = np.random.normal(size=(M, d))

# --- 4) Build conditional mean matrix for V | (xi_1..xi_d)
# A = matrix (n, d) with columns A[:,j] = sqrt(lambda_j) * Phi_j(t)
sqrt_lams = np.sqrt(lambdas[:d])                      # (d,)
# Phi[:d,:] shape (d, n) -> we want (n, d)
A = (sqrt_lams[:, None] * Phi[:d, :]).T               # shape (n, d)

# mean_cond_all shape (n, M) = A @ xi_mat.T
mean_cond_all = A @ xi_mat.T                          # (n, M)

# --- 5) Conditional covariance K = covV - sum_{j=1..d} lambda_j e_j e_j^T ---
Kmat = covV.copy()
for j in range(d):
    ej = Phi[j, :]                                   # length n
    Kmat -= lambdas[j] * np.outer(ej, ej)

# numeric stabilizer (jitter) for Cholesky
jitter = 1e-12
try:
    L = np.linalg.cholesky(Kmat + jitter * np.eye(n))
except np.linalg.LinAlgError:
    jitter = 1e-8
    L = np.linalg.cholesky(Kmat + jitter * np.eye(n))

# --- 6) Simulate conditional paths V_cond = mean_cond + L @ Z for M samples ---
# Be mindful of memory: n x M (100 x 20000) ~ 2e6 floats - OK normally.
Z = np.random.normal(size=(n, M))
V_cond = mean_cond_all + L @ Z                       # shape (n, M)

# compute phi for each conditional sample
phi_cond = np.maximum(0.0, V_cond.mean(axis=0) - K_strike)   # shape (M,)

# Optionally: sanity check that distribution of phi_cond approximates phi_vals
print("phi_cond mean/var:", np.mean(phi_cond), np.var(phi_cond, ddof=1))

inner_e1 = xi_mat @ e1        # (M,)
Y1 = phi_cond - inner_e1      # (M,)
Y1_mean, Y1_var = float(Y1.mean()), float(Y1.var(ddof=1))
print("\nResiduals:")
print(f"  Y1 (phi - e1^T xi): mean = {Y1_mean:.4e}, var = {Y1_var:.4e}")
y_summary = {
    "Y1_mean": Y1_mean, "Y1_var": Y1_var,
    "phi_mean_direct": phi_mean_direct, "phi_var_direct": phi_var_direct
}
print("Y summary:", y_summary)
